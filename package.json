{
  "name": "wayfo",
  "version": "1.0.0",
  "description": "Wayfor通过自动化工具无缝连接Amazon和Wayfair两大电商平台，帮助用户高效迁移和优化家居产品数据，实现从数据采集到上架的全链路自动化，同时注重图片创意再生和人工审核，确保产品质量和合规性。目的是简化电商运营流程，让小型商家或开发者能够轻松扩展业务，创造更多家居领域的创新机会。",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"yarn:dev:server\" \"yarn:dev:web\"",
    "dev:server": "yarn workspace @wayfo/server dev",
    "dev:web": "yarn workspace @wayfo/web dev",
    "build": "yarn workspaces run build",
    "lint": "yarn workspaces run lint",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f"
}
