# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Lockfiles (keep yarn.lock; ignore others to avoid mixing)
package-lock.json
pnpm-lock.yaml

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# dotenv environment variable files
.env
.env.*.local

# VSCode settings
# Commit shared settings/extensions; ignore personal/local-only files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Mac system files
.DS_Store

# next.js
.next/
out/

# build output
dist/
build/

# logs
logs/
*.log

# test output
coverage/
coverage-final.json

# local data
*.sqlite
data/

# Yarn (Berry) + PnP
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Keep SDKs (needed for TS under PnP)
!.yarn/sdks/

# misc
*.local
*.sublime-workspace
*.swp


tsconfig.tsbuildinfo
yarn.lock
pnp.cjs
.pnp.loader.mjs